# =============================================================================
# AWS Configuration
# =============================================================================
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id-here
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here

# =============================================================================
# Amazon Bedrock Configuration
# =============================================================================
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# =============================================================================
# AgentCore Configuration
# =============================================================================
# Memory configuration
AGENTCORE_MEMORY_ID=your-memory-id
AGENTCORE_MEMORY_NAME=agentcore-example-memory

# Gateway configuration
AGENTCORE_GATEWAY_URL=your-gateway-url
AGENTCORE_GATEWAY_REGION=us-east-1

# Runtime configuration
AGENTCORE_RUNTIME_EXECUTION_ROLE=your-runtime-role-arn

# =============================================================================
# External API Keys
# =============================================================================
# NASA API Key (get from https://api.nasa.gov/)
# DEMO_KEY works for testing, but get a real key for production
NASA_API_KEY=DEMO_KEY

# =============================================================================
# OpenTelemetry Configuration for Observability
# =============================================================================
# AWS OpenTelemetry Distribution
OTEL_PYTHON_DISTRO=aws_distro
OTEL_PYTHON_CONFIGURATOR=aws_configurator

# Export Protocol
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp

# CloudWatch Integration
OTEL_EXPORTER_OTLP_LOGS_HEADERS=x-aws-log-group=agentcore/example-logs,x-aws-log-stream=default,x-aws-metric-namespace=agentcore

# Service Identification
OTEL_RESOURCE_ATTRIBUTES=service.name=agentcore-complete-example

# Enable Agent Observability
AGENT_OBSERVABILITY_ENABLED=true

# X-Ray Configuration
OTEL_TRACES_EXPORTER=xray
OTEL_PROPAGATORS=xray

# =============================================================================
# Application Configuration
# =============================================================================
# Logging level
LOG_LEVEL=INFO

# Debug mode
AGENTCORE_DEBUG=false

# Session configuration
DEFAULT_SESSION_ID=example-session-001
DEFAULT_ACTOR_ID=user-001

# =============================================================================
# Development Configuration
# =============================================================================
# Local development settings
DOCKER_CONTAINER=false
LOCAL_DEVELOPMENT=true

# Test configuration
RUN_INTEGRATION_TESTS=false
TEST_TIMEOUT=300
